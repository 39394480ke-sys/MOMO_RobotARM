<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.momo.robotarm.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>__PROJECT_ROOT__/scripts/pull_board_backups_to_mac.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/MOMORobotArmBackup/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/MOMORobotArmBackup/stderr.log</string>
</dict>
</plist>
